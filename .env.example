# ==============================================================================
# Virtual AI Interviewer & AI Career Coach - Environment Configuration
# ==============================================================================

# Application Metadata
PROJECT_NAME="Virtual AI Interviewer – AI Career Coach"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (SQLite default with strict user isolation)
DATABASE_URL="sqlite:///./career_coach.db"

# Security & Session Authentication
# IMPORTANT: Generate a strong, random 64-character secret in production (e.g., openssl rand -hex 32)
SECRET_KEY="super-secret-career-coach-ai-jwt-key-2026-antigravity"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# File Storage Paths (Isolated Private Directories)
STORAGE_BASE_PATH="./storage"
STORAGE_RESUMES="./storage/resumes"
STORAGE_RECORDINGS="./storage/recordings"
STORAGE_REPORTS="./storage/reports"
STORAGE_GENERATED_RESUMES="./storage/generated_resumes"

# Modular AI Providers Hierarchy:
# Priority Chain: Ollama (Primary Local) -> LM Studio -> Hugging Face -> Groq -> In-Memory Fallback
DEFAULT_LLM_PROVIDER="ollama"

# 1. Ollama Local Endpoint & Model (Strictly Local Open-Weights)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# 2. LM Studio Local Endpoint & Model
LM_STUDIO_BASE_URL="http://localhost:1234/v1"
LM_STUDIO_MODEL="local-model"

# 3. Hugging Face Inference API
HUGGINGFACE_API_KEY=""
HUGGINGFACE_MODEL="mistralai/Mistral-7B-Instruct-v0.2"

# 4. Groq Cloud LPU (Ultra-Low Latency Free Tier)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Sandbox Execution Security Bounds
SANDBOX_TIMEOUT_SECONDS=3.0
SANDBOX_MEMORY_LIMIT_MB=128
